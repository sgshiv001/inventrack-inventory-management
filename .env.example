# Copy this file to .env on your PC. Never commit real secrets.
PORT=3000
HOST=127.0.0.1
# Optional absolute path on a persistent local disk. Blank uses the OS-local data directory.
DB_PATH=

# Required on first startup of a fresh standalone web database.
ORGANIZATION_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_TTL_MS=28800000

# Optional when the static frontend and API use different domains.
# Set this to the exact frontend origin, for example https://app.example.com
CORS_ORIGIN=
