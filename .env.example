# Copy this file to .env in your deployment platform. Never commit real secrets.
PORT=3000
HOST=0.0.0.0
# Optional absolute path on a persistent local disk. Blank uses the OS-local data directory.
DB_PATH=

# Set true for a protected deployment. When enabled, provide a strong bootstrap admin.
AUTH_REQUIRED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_TTL_MS=28800000

# Optional when the static frontend and API use different domains.
# Set this to the exact frontend origin, for example https://app.example.com
CORS_ORIGIN=
