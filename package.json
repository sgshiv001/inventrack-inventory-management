{
  "name": "inventrack",
  "productName": "InvenTrack",
  "version": "3.0.5",
  "private": true,
  "author": {
    "name": "Shivanshu Gupta",
    "url": "https://github.com/sgshiv001"
  },
  "description": "InvenTrack inventory management for Windows and the web.",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "desktop": "electron .",
    "desktop:package": "electron-forge package --platform win32",
    "desktop:make": "electron-forge make --platform win32",
    "db:migrate": "node tools/database.cjs migrate",
    "db:backup": "node tools/database.cjs backup",
    "db:restore": "node tools/database.cjs restore",
    "test": "node --test tests/globe.cjs tests/static.cjs tests/database.cjs tests/frontend.cjs tests/scanner.cjs tests/downloads.cjs tests/local-server.cjs && node tests/backend.cjs && node tests/auth.cjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "electron": "^44.5.1"
  },
  "dependencies": {
    "@zxing/browser": "0.2.1",
    "electron-squirrel-startup": "^1.0.1"
  }
}
